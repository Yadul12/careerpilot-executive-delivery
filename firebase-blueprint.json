{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated executive career platform user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 255
        },
        "roleName": {
          "type": "string",
          "description": "Assigned RBAC role",
          "enum": ["Administrator", "Client Delivery Owner", "Research Associate", "Client"],
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "roleName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles keyed by Firebase Auth UID"
    }
  }
}
